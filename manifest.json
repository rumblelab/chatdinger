{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Chat Dinger \u2013 Notification Sound for ChatGPT",
  "short_name": "Chat Dinger",
  "version": "2.0.31",
  "description": "Sound alert when ChatGPT finishes a response or image. Works in every ChatGPT language. Marks the tab until you open the answer.",
  "homepage_url": "https://chatdinger.com",
  "permissions": [
    "storage",
    "scripting",
    "notifications",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chat Dinger Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "shared.js",
        "detector.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}

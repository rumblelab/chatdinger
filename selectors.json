{
  "version": 1,
  "mainButtonSelectors": [
    "[data-composer-footer-responsive] button[aria-label=\"Stop\"]",
    "[data-composer-footer-responsive] button.bg-composer-primary",
    "button[aria-label=\"Stop streaming\"]",
    "button[aria-label=\"Stop generating\"]",
    "button[aria-label=\"Send prompt\"]",
    "button[aria-label=\"Send message\"], button[aria-label=\"Send\"]",
    "button[data-composer-submit]",
    "#composer-submit-button",
    "button[data-testid$=\"send-button\"]",
    "button[data-testid$=\"stop-button\"]",
    "button.composer-submit-button-color"
  ],
  "muteToggleSelectors": {
    "dictateButton": "button[aria-label=\"Dictate\"],[data-composer-trailing] > :not([data-idle-home]):not([hidden]),button.wm-composer-dictationButton,button[aria-label=\"Start dictation\"]:not([data-idle-home]),button[aria-label=\"Dictate button\"]",
    "flexWrapper": "[data-composer-trailing],.wm-composer-trailing,[class*=\"items-center\"][class*=\"gap-1.5\"]:not(button),div.flex.items-center"
  }
}
